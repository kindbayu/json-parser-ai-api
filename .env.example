# ============================================================
# AI Engine API v3.0 — Environment Configuration
# Option A: Groq  (cloud, free, fast) ← recommended for deployment
# Option B: Ollama (local, free, slow without GPU)
# ============================================================

# LLM Provider: "groq" or "ollama"
LLM_PROVIDER=groq

# Groq Configuration (https://console.groq.com — free, no credit card)
# NOTE: llama-3.1-8b-instant & llama-3.3-70b-versatile are now Groq Enterprise
# models — a free key gets 404 model_not_found. Verify with GET /api/v1/llm/models
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama Configuration (only used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Embedding Model (HuggingFace — always local, free)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB storage path
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# App Configuration
APP_TITLE=AI Engine API
APP_VERSION=3.0.0
CONTACT_EMAIL=admin@example.com
DEBUG=False

# Optional: proteksi endpoint dengan header X-API-Key.
# Kosong/nonaktif = endpoint terbuka (perilaku default).
# API_KEY=rahasia-panjang-anda
