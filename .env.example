# ============================================================
# PT Multisari Indoprima — AI Engine v3.0
# Option A: Ollama (lokal, gratis, lambat)
# Option B: Groq  (cloud, gratis, cepat) ← recommended untuk deploy
# ============================================================

# ------------------------------------------------------------------
# LLM Provider: "ollama" atau "groq"
# ------------------------------------------------------------------
LLM_PROVIDER=groq

# Groq Configuration (https://console.groq.com — gratis, tanpa kartu kredit)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Configuration (hanya dipakai jika LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Embedding Configuration (HuggingFace — tetap lokal/VPS, gratis)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# App Configuration
APP_TITLE=AI Engine API
APP_VERSION=3.0.0
DEBUG=False
