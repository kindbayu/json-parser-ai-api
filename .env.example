# ============================================================
# AI Engine API v3.0 — Environment Configuration
# Option A: Groq  (cloud, free, fast) ← recommended for deployment
# Option B: Ollama (local, free, slow without GPU)
# ============================================================

# LLM Provider: "groq" or "ollama"
LLM_PROVIDER=groq

# Groq Configuration (https://console.groq.com — free, no credit card)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (only used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Embedding Model (HuggingFace — always local, free)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB storage path
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# App Configuration
APP_TITLE=AI Engine API
APP_VERSION=3.0.0
CONTACT_EMAIL=admin@example.com
DEBUG=False
